<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/control_button"
            android:text="← 返回"
            android:textColor="@color/control_text"
            android:textSize="14sp"
            android:minHeight="48dp"
            app:backgroundTint="@color/ui_control" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/ui_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pref_http_port"
                android:textColor="@color/ui_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etHttpPort"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/surface_field"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="8080"
                android:textColor="@color/ui_text"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/pref_default_facing"
                android:textColor="@color/ui_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/rgFacing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/rbFacingBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Back (后置)"
                    android:textColor="@color/ui_text" />
                <RadioButton
                    android:id="@+id/rbFacingFront"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="Front (前置)"
                    android:textColor="@color/ui_text" />
            </RadioGroup>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/pref_resolution"
                android:textColor="@color/ui_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/spResolution"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:paddingStart="8dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/pref_target_fps"
                android:textColor="@color/ui_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/spFps"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:paddingStart="8dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/pref_jpeg_quality"
                android:textColor="@color/ui_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etQuality"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/surface_field"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="80"
                android:textColor="@color/ui_text"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/pref_dim_timeout"
                android:textColor="@color/ui_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etDimTimeout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/surface_field"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="30"
                android:textColor="@color/ui_text"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/pref_retention_grace_period"
                android:textColor="@color/ui_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/etRetentionGracePeriod"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/surface_field"
                android:inputType="number"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="5"
                android:textColor="@color/ui_text"
                android:textSize="14sp" />
            <CheckBox
                android:id="@+id/cbAuthEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pref_auth_enabled"
                android:textColor="@color/ui_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/layoutAuthFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pref_auth_username"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etAuthUsername"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/surface_field"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="admin"
                    android:textColor="@color/ui_text"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pref_auth_password"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etAuthPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/surface_field"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="password"
                    android:textColor="@color/ui_text"
                    android:textSize="14sp" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp"
                android:background="#2A2A2A" />
            <CheckBox
                android:id="@+id/cbMqttEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pref_mqtt_enabled"
                android:textColor="@color/ui_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/layoutMqttFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pref_mqtt_host"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etMqttHost"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/surface_field"
                    android:hint="如 192.168.1.100 或 homeassistant.local"
                    android:inputType="textUri"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/ui_text"
                    android:textColorHint="#666666"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pref_mqtt_port"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etMqttPort"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/surface_field"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="1883"
                    android:textColor="@color/ui_text"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pref_mqtt_client_id"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etMqttClientId"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/surface_field"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/ui_text"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pref_auth_username"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etMqttUsername"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/surface_field"
                    android:hint="可选 (留空为匿名连接)"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/ui_text"
                    android:textColorHint="#666666"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pref_auth_password"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etMqttPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/surface_field"
                    android:hint="可选"
                    android:inputType="textPassword"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/ui_text"
                    android:textColorHint="#666666"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pref_mqtt_topic_prefix"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etMqttTopicPrefix"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/surface_field"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="camera_agent"
                    android:textColor="@color/ui_text"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/btnTestMqtt"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    app:backgroundTint="@color/ui_control"
                    android:text="@string/btn_test_mqtt"
                    android:textColor="@color/control_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/control_button"
                    android:minHeight="48dp" />
                <TextView
                    android:id="@+id/tvMqttTestResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp"
                android:background="#2A2A2A" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="锁屏与后台常驻优化 (Keepalive)"
                android:textColor="@color/ui_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/battery_opt_hint"
                android:textColor="@color/ui_text_secondary"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btnBatteryOpt"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                app:backgroundTint="@color/ui_control"
                android:text="@string/btn_battery_opt"
                android:textColor="@color/control_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/control_button"
                android:minHeight="48dp" />
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                app:backgroundTint="@color/ui_control"
                android:text="@string/btn_save_settings"
                android:textColor="@color/control_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/control_button"
                android:minHeight="48dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                android:background="#333333" />
            <Button
                android:id="@+id/btnOpenDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:backgroundTint="@color/ui_control"
                android:text="@string/btn_open_diagnostics"
                android:textColor="@color/control_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/control_button"
                android:minHeight="48dp" />
            <Button
                android:id="@+id/btnPreview"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                app:backgroundTint="@color/ui_control"
                android:text="@string/btn_preview"
                android:textColor="@color/control_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/control_button"
                android:minHeight="48dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
