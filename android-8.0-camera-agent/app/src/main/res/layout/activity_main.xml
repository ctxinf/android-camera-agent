<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:id="@+id/contentLayout">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="24dp">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Camera Agent" android:textSize="26sp" android:textColor="@color/ui_text" android:textStyle="bold" />
                <ImageButton android:id="@+id/btnSettingsIcon" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/control_button" android:src="@drawable/ic_settings" android:tint="@color/ui_primary" android:padding="12dp" android:contentDescription="@string/settings_title" />
            </LinearLayout>
            <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/surface_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="12dp">
                    <TextView android:id="@+id/tvHttpStatus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/ui_text" android:textSize="14sp" />
                    <TextView android:id="@+id/tvHttpConnections" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ui_text_secondary" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="12dp">
                    <TextView android:id="@+id/tvMcpStatus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/ui_text" android:textSize="14sp" />
                    <TextView android:id="@+id/tvMcpConnections" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ui_text_secondary" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:id="@+id/tvMqttStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:textColor="@color/ui_text" android:textSize="14sp" />
                <LinearLayout android:id="@+id/facingSegmentedContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="16dp">
                    <View android:id="@+id/cameraHardwareLed" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginRight="8dp" android:background="@drawable/led_grey" />
                    <TextView android:id="@+id/tvCameraHardwareStatus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="镜头:" android:textColor="@color/ui_text" android:textSize="14sp" />
                    <Button android:id="@+id/btnFacingBack" android:layout_width="56dp" android:layout_height="48dp" android:layout_marginLeft="4dp" android:padding="4dp" android:minWidth="0dp" android:text="后置" android:textSize="14sp" android:textColor="@color/control_text" android:background="@drawable/control_button" app:backgroundTint="@color/ui_control" />
                    <Button android:id="@+id/btnFacingFront" android:layout_width="56dp" android:layout_height="48dp" android:layout_marginLeft="4dp" android:padding="4dp" android:minWidth="0dp" android:text="前置" android:textSize="14sp" android:textColor="@color/control_text" android:background="@drawable/control_button" app:backgroundTint="@color/ui_control" />
                    <Button android:id="@+id/btnFacingDisabled" android:layout_width="64dp" android:layout_height="48dp" android:layout_marginLeft="4dp" android:padding="4dp" android:minWidth="0dp" android:text="禁用" android:textSize="14sp" android:textColor="@color/control_text" android:background="@drawable/control_button" app:backgroundTint="@color/ui_control" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="16dp">
                    <View android:id="@+id/statusLed" android:layout_width="16dp" android:layout_height="16dp" android:layout_marginRight="10dp" android:background="@drawable/led_green" />
                    <TextView android:id="@+id/tvStatusText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="后台服务 · 开启" android:textColor="@color/ui_text" android:textStyle="bold" android:textSize="16sp" android:layout_marginRight="8dp" />
                    <ToggleButton android:id="@+id/tbCameraEnable" android:layout_width="64dp" android:layout_height="48dp" android:textOn="开启" android:textOff="关闭" android:checked="true" android:background="@drawable/control_button" android:textColor="@color/control_text" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_card"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="连接与接口"
                    android:textSize="18sp"
                    android:textColor="@color/ui_text"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="同一局域网内可访问以下服务"
                    android:textSize="12sp"
                    android:textColor="@color/ui_text_secondary"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="http://127.0.0.1:8080"
                    android:textSize="16sp"
                    android:textColor="@color/ui_primary"
                    android:id="@+id/tvBaseEndpoint"
                    android:textIsSelectable="true" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="已启用认证"
                    android:textSize="12sp"
                    android:textColor="@color/ui_warning"
                    android:id="@+id/tvAuthBadge"
                    android:visibility="gone"
                    android:layout_marginTop="8dp" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPaths"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSnapshot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/snapshot.jpg"
                        style="@style/Widget.CameraAgent.PathChip" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStream"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/video.mjpeg"
                        style="@style/Widget.CameraAgent.PathChip" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/api/status"
                        style="@style/Widget.CameraAgent.PathChip" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMcp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/mcp"
                        style="@style/Widget.CameraAgent.PathChip" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCameraConfig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/api/camera"
                        style="@style/Widget.CameraAgent.PathChip" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWarmup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/api/v1/warmup"
                        style="@style/Widget.CameraAgent.PathChip" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipHealth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/health"
                        style="@style/Widget.CameraAgent.PathChip" />
                </com.google.android.material.chip.ChipGroup>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择接口查看使用说明"
                    android:textSize="13sp"
                    android:textColor="@color/ui_text_secondary"
                    android:id="@+id/tvEndpointSummary"
                    android:textIsSelectable="true"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:id="@+id/tvDeviceStatus"
                android:layout_marginTop="20dp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
