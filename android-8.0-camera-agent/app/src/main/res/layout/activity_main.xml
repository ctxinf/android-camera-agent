<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0E12">

    <!-- Top Compact Bar: 🟢 服务[开/关] | ⚪ MQTT | [后置|前置] | ⚪ CAM空闲 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_alignParentTop="true"
        android:background="#13171F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- 1. 🟢 服务开启 [开/关] -->
        <LinearLayout
            android:id="@+id/statusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusLed"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/led_green" />

            <TextView
                android:id="@+id/tvStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="服务"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ToggleButton
                android:id="@+id/tbCameraEnable"
                android:layout_width="38dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:checked="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textOff="关"
                android:textOn="开"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. ⚪ MQTT -->
        <TextView
            android:id="@+id/tvMqttStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="⚪ MQTT"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 3. [后置 | 前置] -->
        <LinearLayout
            android:id="@+id/facingSegmentedContainer"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:background="#1F2633"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="2dp">

            <Button
                android:id="@+id/btnFacingBack"
                android:layout_width="34dp"
                android:layout_height="22dp"
                android:backgroundTint="#00E05A"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="后置"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFacingFront"
                android:layout_width="34dp"
                android:layout_height="22dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#262F3D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="前置"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 4. ⚪ CAM空闲 -->
        <LinearLayout
            android:id="@+id/hardwareIndicatorContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/cameraHardwareLed"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/led_grey" />

            <TextView
                android:id="@+id/tvCameraHardwareStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:singleLine="true"
                android:text="CAM空闲"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Layout -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/bottomBar"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <!-- Modern Web-Style HTTP Endpoint Card -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#161A22"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- First Row: Base Endpoint Header & Auth Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="HTTP SERVICE ENDPOINT"
                        android:textColor="#8090A0"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvAuthBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#2E2415"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="🔒 Auth"
                        android:textColor="#FFB300"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBaseEndpoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:text="http://127.0.0.1:8080"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textIsSelectable="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#242B38" />

                <!-- Label / Paths Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="API PATHS &amp; SERVICES"
                        android:textColor="#8090A0"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击标签查看详情"
                        android:textColor="#667788"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Flex / Wrap Chip Group for Paths -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPaths"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="4dp"
                    app:chipSpacingVertical="4dp"
                    app:singleLine="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSnapshot"
                        style="@style/Widget.CameraAgent.PathChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[/snapshot.jpg]" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStream"
                        style="@style/Widget.CameraAgent.PathChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[/video.mjpeg]" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStatus"
                        style="@style/Widget.CameraAgent.PathChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[/api/status]" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMcp"
                        style="@style/Widget.CameraAgent.PathChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[/mcp]" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCameraConfig"
                        style="@style/Widget.CameraAgent.PathChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[/api/camera]" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWarmup"
                        style="@style/Widget.CameraAgent.PathChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[/api/v1/warmup]" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipHealth"
                        style="@style/Widget.CameraAgent.PathChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[/health]" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Detailed Quick View Area -->
                <TextView
                    android:id="@+id/tvEndpointSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#0F1217"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:padding="10dp"
                    android:text="提示: 点击上方标签查看具体 API 用法与 HA 集成说明"
                    android:textColor="#88A0B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Device Status Line -->
        <TextView
            android:id="@+id/tvDeviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#777777"
            android:textSize="11sp"
            android:text="Device Status: OK" />
    </LinearLayout>

    <!-- Bottom Bar: Only Single Settings Icon Button on the Right -->
    <RelativeLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:background="#13171F"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageButton
            android:id="@+id/btnSettingsIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title"
            android:padding="8dp"
            android:src="@drawable/ic_settings"
            android:tint="#8090A0" />
    </RelativeLayout>

</RelativeLayout>
