<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomBar"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:id="@+id/contentLayout">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Camera Agent"
                android:textSize="28sp"
                android:textColor="@color/ui_text"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="设备控制台"
                android:textSize="13sp"
                android:textColor="@color/ui_text_secondary"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp" />
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <View
                        android:id="@+id/statusLed"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/led_green"
                        android:layout_marginRight="10dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="摄像头服务"
                        android:textSize="16sp"
                        android:textColor="@color/ui_text"
                        android:id="@+id/tvStatusText"
                        android:layout_weight="1"
                        android:layout_marginRight="12dp" />
                    <ToggleButton
                        android:id="@+id/tbCameraEnable"
                        android:layout_width="64dp"
                        android:layout_height="48dp"
                        android:background="@drawable/control_button"
                        android:textOn="开启"
                        android:textOff="关闭"
                        android:textSize="14sp"
                        android:textColor="@color/control_text"
                        android:checked="true"
                        android:backgroundTint="@null" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择镜头"
                    android:textSize="12sp"
                    android:textColor="@color/ui_text_secondary"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:id="@+id/facingSegmentedContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnFacingBack"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:layout_marginRight="4dp"
                        android:text="后置"
                        android:textSize="14sp"
                        android:textColor="@color/control_text"
                        android:background="@drawable/control_button"
                        app:backgroundTint="@color/ui_control" />
                    <Button
                        android:id="@+id/btnFacingFront"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:layout_marginRight="4dp"
                        android:text="前置"
                        android:textSize="14sp"
                        android:textColor="@color/control_text"
                        android:background="@drawable/control_button"
                        app:backgroundTint="@color/ui_control" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="MQTT · 未连接"
                        android:textSize="12sp"
                        android:textColor="@color/ui_text_secondary"
                        android:id="@+id/tvMqttStatus"
                        android:layout_weight="1" />
                    <View
                        android:id="@+id/cameraHardwareLed"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/led_grey"
                        android:layout_marginRight="6dp" />
                    <TextView
                        android:id="@+id/tvCameraHardwareStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="相机空闲"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/surface_card"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="连接与接口"
                    android:textSize="18sp"
                    android:textColor="@color/ui_text"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="同一局域网内可访问以下服务"
                    android:textSize="12sp"
                    android:textColor="@color/ui_text_secondary"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="http://127.0.0.1:8080"
                    android:textSize="16sp"
                    android:textColor="@color/ui_primary"
                    android:id="@+id/tvBaseEndpoint"
                    android:textIsSelectable="true" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="已启用认证"
                    android:textSize="12sp"
                    android:textColor="@color/ui_warning"
                    android:id="@+id/tvAuthBadge"
                    android:visibility="gone"
                    android:layout_marginTop="8dp" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPaths"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSnapshot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/snapshot.jpg"
                        style="@style/Widget.CameraAgent.PathChip" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStream"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/video.mjpeg"
                        style="@style/Widget.CameraAgent.PathChip" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/api/status"
                        style="@style/Widget.CameraAgent.PathChip" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMcp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/mcp"
                        style="@style/Widget.CameraAgent.PathChip" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCameraConfig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/api/camera"
                        style="@style/Widget.CameraAgent.PathChip" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWarmup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/api/v1/warmup"
                        style="@style/Widget.CameraAgent.PathChip" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipHealth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/health"
                        style="@style/Widget.CameraAgent.PathChip" />
                </com.google.android.material.chip.ChipGroup>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择接口查看使用说明"
                    android:textSize="13sp"
                    android:textColor="@color/ui_text_secondary"
                    android:id="@+id/tvEndpointSummary"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:id="@+id/tvDeviceStatus"
                android:layout_marginTop="20dp" />
        </LinearLayout>
    </ScrollView>
    <RelativeLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:padding="12dp"
        android:background="@color/ui_surface">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CAMERA AGENT"
            android:textSize="12sp"
            android:textColor="@color/ui_text_secondary"
            android:layout_centerVertical="true" />
        <ImageButton
            android:id="@+id/btnSettingsIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentRight="true"
            android:background="@drawable/control_button"
            android:src="@drawable/ic_settings"
            android:tint="@color/ui_primary"
            android:padding="12dp"
            android:contentDescription="@string/settings_title" />
    </RelativeLayout>
</RelativeLayout>
