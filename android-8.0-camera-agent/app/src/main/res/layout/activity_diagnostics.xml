<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ui_text" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/diagnostics_title"
            android:textColor="@color/ui_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDeviceInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/ui_text_secondary"
        android:textSize="12sp"
        android:text="Device: Loading..." />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/surface_card"
        android:padding="12dp"
        android:text="Status: Ready"
        android:textColor="@color/ui_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvCameraInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/surface_field"
        android:padding="12dp"
        android:text="Cameras: Probing..."
        android:textColor="@color/ui_text"
        android:textSize="12sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnProbe"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="Probe"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/control_button"
            android:textColor="@color/control_text" />

        <Button
            android:id="@+id/btnStartService"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Service"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/control_button"
            android:textColor="@color/control_text" />

        <Button
            android:id="@+id/btnSnapshot"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Snapshot"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/control_button"
            android:textColor="@color/control_text" />

        <Button
            android:id="@+id/btnClearLogs"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:text="Clear"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/control_button"
            android:textColor="@color/control_text" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Live Diagnostic Logs:"
        android:textColor="@color/ui_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/svLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/surface_field"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/ui_primary"
            android:textSize="11sp" />
    </ScrollView>
</LinearLayout>
