<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/control_button"
            android:text="← 返回"
            android:textColor="@color/control_text"
            android:textSize="13sp"
            android:minHeight="48dp"
            app:backgroundTint="@color/ui_control" />
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/diagnostics_title"
            android:textColor="@color/ui_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvDeviceInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/ui_text_secondary"
        android:textSize="12sp"
        android:text="Device: Loading..." />
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#222222"
        android:padding="8dp"
        android:text="Status: Ready"
        android:textColor="@color/ui_primary"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/tvCameraInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#1A1A1A"
        android:padding="8dp"
        android:text="Cameras: Probing..."
        android:textColor="#DDDDDD"
        android:textSize="11sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnProbe"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Probe"
            android:textSize="12sp"
            android:background="@drawable/control_button"
            android:minHeight="48dp"
            android:textColor="@color/control_text"
            app:backgroundTint="@color/ui_control" />
        <Button
            android:id="@+id/btnStartService"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Service"
            android:textSize="12sp"
            android:background="@drawable/control_button"
            android:minHeight="48dp"
            android:textColor="@color/control_text"
            app:backgroundTint="@color/ui_control" />
        <Button
            android:id="@+id/btnSnapshot"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Snapshot"
            android:textSize="12sp"
            android:background="@drawable/control_button"
            android:minHeight="48dp"
            android:textColor="@color/control_text"
            app:backgroundTint="@color/ui_control" />
        <Button
            android:id="@+id/btnClearLogs"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="Clear"
            android:textSize="12sp"
            android:background="@drawable/control_button"
            android:minHeight="48dp"
            android:textColor="@color/control_text"
            app:backgroundTint="@color/ui_control" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Live Diagnostic Logs:"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:textStyle="bold" />
    <ScrollView
        android:id="@+id/svLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="#050505"
        android:padding="8dp">
        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/ui_primary"
            android:textSize="11sp" />
    </ScrollView>
</LinearLayout>
