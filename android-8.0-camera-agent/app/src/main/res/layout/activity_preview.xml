<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/control_button"
            android:text="← 返回"
            android:textColor="@color/control_text"
            android:textSize="14sp"
            android:minHeight="48dp"
            app:backgroundTint="@color/ui_control" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/preview_title"
            android:textColor="@color/ui_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="#181818">
        <SurfaceView
            android:id="@+id/previewSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView
            android:id="@+id/tvPreviewStatus"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Preview Stopped"
            android:textColor="@color/ui_text"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>
    <TextView
        android:id="@+id/tvPreviewInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/ui_primary"
        android:textSize="13sp"
        android:text="Camera: Initializing..." />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnTogglePreview"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            app:backgroundTint="@color/ui_control"
            android:text="@string/preview_on"
            android:textColor="@color/control_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/control_button"
            android:minHeight="48dp" />
        <Button
            android:id="@+id/btnRotate"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            app:backgroundTint="@color/ui_control"
            android:text="@string/btn_rotate"
            android:textColor="@color/control_text"
            android:textSize="14sp"
            android:background="@drawable/control_button"
            android:minHeight="48dp" />
    </LinearLayout>
</LinearLayout>
